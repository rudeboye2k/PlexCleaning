# Copy to .env next to docker-compose.yml (or next to config.yaml) and fill in.
# config.yaml reads these via ${VAR} interpolation, so no secrets live in YAML.

# openssl rand -hex 32
PLEXCLEANER_SECRET_KEY=
# Password for the web UI. Leave empty to disable the login prompt.
PLEXCLEANER_PASSWORD=

# Plex → any web player, open a library item, Get Info → View XML, copy X-Plex-Token
PLEX_TOKEN=

# Tautulli → Settings → Web Interface → API key
TAUTULLI_API_KEY=

# Sonarr → Settings → General → API Key
SONARR_API_KEY=

# Radarr → Settings → General → API Key
RADARR_API_KEY=

# Overseerr/Jellyseerr/Seerr → Settings → General → API Key
SEERR_API_KEY=

TZ=UTC
